# Server
APP_PORT=3700
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/momentum?schema=public"
DIRECT_URL="postgresql://postgres:admin@localhost:5432/momentum?schema=public"

# Auth
SESSION_JWT_SECRET="change-me-min-32-bytes-please-change-in-prod"
SESSION_JWT_EXPIRES_IN=24h

# Frontend / CORS
FRONTEND_URL=http://localhost:3000

# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
MOMENTUM_PROGRAM_ID=39oqYsjuQLkFLEieaP7tisN8Bq4K8A2fS2gttKaFwTAT
TXLINE_PROGRAM_ID=6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J
TXLINE_BASE_URL=https://txline-dev.txodds.com
# Keeper credential — set exactly ONE of these two:
#
# LOCAL DEV: uncomment the path (default Solana CLI keyfile location)
KEEPER_KEYPAIR_PATH=~/.config/solana/id.json
#
# PRODUCTION (Railway / Fly / Docker / any container): use the JSON array.
# Extract with: cat ~/.config/solana/id.json
# Paste the exact output (starts with `[`, ends with `]`, 64 comma-separated numbers).
# KEEPER_SECRET_JSON=[123,45,67,89,...]

# Metaplex / DAS
HELIUS_API_KEY=
METADATA_HOST=https://cdn.momentum.app

# Observability
SENTRY_DSN=

# Replay mode (judging-day insurance)
REPLAY_MODE=false
REPLAY_FIXTURE_ID=18237038
REPLAY_SPEED=5
REPLAY_START_SEQ=1
REPLAY_END_SEQ=9223372036854775807

# Feature flags
MOMENTUM_FF_KORA=false
MOMENTUM_FF_TURNKEY=false
MOMENTUM_FF_BLINKS=true
MOMENTUM_FF_SETTLER=true
MOMENTUM_FF_HELIUS_DAS=false

# Telegram companion bot.
# Optional. If TELEGRAM_BOT_TOKEN is unset, the bot is silently disabled
# and POST /api/notify/telegram returns 204 { ok:false, reason:'bot_disabled' }.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# Shared secret protecting POST /api/notify/telegram. Min 16 chars if set.
# The settler worker sends this in the X-Notify-Secret header.
NOTIFY_SHARED_SECRET=
# Override the URL the settler POSTs back to (default: http://localhost:${APP_PORT}).
BACKEND_INTERNAL_URL=
# Optional Solscan cluster override (devnet | mainnet-beta | testnet).
SOLSCAN_CLUSTER=
